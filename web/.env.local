# Local environment variables for development
# Fill these values from your Sanity project settings. Do NOT commit real secrets to the repo.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Optional: server-only read token for preview/drafts. Keep this secret and set in Vercel as an env var instead of committing.
SANITY_READ_TOKEN=
